# Copy to deploy/.env on the server and fill in. Never commit the filled-in file.
APP_DOMAIN=app.taamara.in
POSTGRES_PASSWORD=change-me-to-a-long-random-string

BETTER_AUTH_URL=https://app.taamara.in
APP_URL=https://app.taamara.in
# openssl rand -base64 32 (each); keep FIELD_ENCRYPTION_KEY safe: bank details can't be read without it.
BETTER_AUTH_SECRET=
FIELD_ENCRYPTION_KEY=

# Files in a private S3 bucket in Mumbai. Credentials come from the server's IAM role.
STORAGE_DRIVER=s3
S3_BUCKET=taamara-files
AWS_REGION=ap-south-1

# Notifications beyond the bell. Web push: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taamara.in
# Email through SES Mumbai, once the domain is verified there.
EMAIL_DRIVER=ses
EMAIL_FROM=Taamara Taamara <no-reply@taamara.in>

VIDEO_WORKERS=1

# Nightly backups (deploy/backup-to-s3.sh).
BACKUP_BUCKET=taamara-backups
