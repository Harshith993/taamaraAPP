# HTTPS for the app (certificates from Let's Encrypt, renewed automatically).
{$APP_DOMAIN} {
	encode zstd gzip
	# Uploads come in 4 MB pieces (D23); anything far bigger is refused here.
	request_body {
		max_size 12MB
	}
	reverse_proxy app:3000 {
		# Live chat updates are Server-Sent Events (D41): send them on at once.
		flush_interval -1
	}
}
