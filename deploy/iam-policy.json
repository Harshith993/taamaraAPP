{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AppFiles",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::taamara-files/*"
    },
    {
      "Sid": "AppFilesList",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::taamara-files"
    },
    {
      "Sid": "NightlyBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::taamara-backups/*"
    },
    {
      "Sid": "NotificationEmail",
      "Effect": "Allow",
      "Action": ["ses:SendEmail"],
      "Resource": "*",
      "Condition": { "StringEquals": { "ses:FromAddress": "no-reply@taamara.in" } }
    }
  ]
}
