# Copy to .env and fill in. Never commit .env.

# PostgreSQL (AWS Mumbai in production; local for development)
DATABASE_URL="postgresql://taamara:taamara_dev@localhost:5432/taamara_dev?schema=public"

# Used only by the test suite; it is wiped and rebuilt on every test run.
TEST_DATABASE_URL="postgresql://taamara:taamara_dev@localhost:5432/taamara_test?schema=public"

# Better Auth: a long random string (openssl rand -base64 32) and the public URL.
BETTER_AUTH_SECRET="replace-with-32-plus-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Key for encrypting bank and ID details at rest (openssl rand -base64 32).
FIELD_ENCRYPTION_KEY="replace-with-base64-32-bytes"

# Uploaded files. "local" keeps them on this server's disk (development); "s3" (Phase 10) uses a
# private bucket in AWS Mumbai.
STORAGE_DRIVER="local"
STORAGE_DIR="./data/storage"
# ffmpeg and ffprobe make video thumbnails and playable copies (defaults: found on PATH).
# FFMPEG_PATH="/usr/bin/ffmpeg"
# FFPROBE_PATH="/usr/bin/ffprobe"

# Videos converted at the same time (1 keeps pages quickest; 2 suits a 4-CPU server). docs/OPERATIONS.md
VIDEO_WORKERS=1
